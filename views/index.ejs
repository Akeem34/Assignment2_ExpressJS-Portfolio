<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/content/app.css' />
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css"/>
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css"/>
    <script src=" /bootstrap/dist/js/bootstrap.min.js"></script>
  </head>
  <body>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
    <script src="/WebProject/public/Scripts/app.js"></script>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Akeem Lanade</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">

          <li class="nav-item">
        <% if(title == "Home"){ %>
          <a class="nav-link active" aria-current="page" href="/home"><i class="fa-regular fa-house"></i> Home</a>
        <% } else { %>
          <a class="nav-link" href="/home"><i class="fa-regular fa-house"></i> Home</a>
        <% } %>
      </li>

      <li class="nav-item">
        <% if(title == "About Me" || title == "About"){ %>
          <a class="nav-link active" aria-current="page" href="/About"><i class="fa-regular fa-user"></i> About Me</a>
        <% } else { %>
          <a class="nav-link" href="/About"><i class="fa-regular fa-user"></i> About Me</a>
        <% } %>
      </li>

      <li class="nav-item">
        <% if(title == "Projects"){ %>
          <a class="nav-link active" aria-current="page" href="/Projects"><i class="fa-solid fa-list-check"></i> Projects</a>
        <% } else { %>
          <a class="nav-link" href="/Projects"><i class="fa-solid fa-list-check"></i> Projects</a>
        <% } %>
      </li>

      <li class="nav-item">
        <% if(title == "Contact"){ %>
          <a class="nav-link active" aria-current="page" href="/Contact"><i class="fa-regular fa-address-book"></i> Contact</a>
        <% } else { %>
          <a class="nav-link" href="/Contact"><i class="fa-regular fa-address-book"></i> Contact</a>
        <% } %>
      </li>


          
      </ul>
      
    </div>
  </div>
</nav>
  </body>
</html>
